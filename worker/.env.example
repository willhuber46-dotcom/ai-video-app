# Supabase project (Settings > API). The service role key bypasses RLS: keep it server-side only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Speech-to-text
DEEPGRAM_API_KEY=

# Optional: retake detection with Claude. Without it a built-in heuristic is used.
ANTHROPIC_API_KEY=

# Optional tuning
WORKER_CONCURRENCY=1
WORKER_POLL_MS=3000
# For cost tracking
DEEPGRAM_USD_PER_MINUTE=0.0043
WORKER_USD_PER_HOUR=0.05

# Optional: Expo access token, if push security is enabled for your Expo project
EXPO_ACCESS_TOKEN=
# Housekeeping interval (expiry warnings, 30-day deletion, account deletion)
WORKER_MAINTENANCE_MS=60000

# Billing server (npm run billing -w worker). Stripe keys from dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where the billing server is reachable, e.g. https://billing.example.com
BILLING_PUBLIC_URL=
APP_SCHEME=appname
PORT=8787
