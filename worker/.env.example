# Supabase project (Settings > API). The service role key bypasses RLS: keep it server-side only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Speech-to-text
DEEPGRAM_API_KEY=

# Optional: retake detection with Claude. Without it a built-in heuristic is used.
ANTHROPIC_API_KEY=

# Optional tuning
WORKER_CONCURRENCY=1
WORKER_POLL_MS=3000
# For cost tracking
DEEPGRAM_USD_PER_MINUTE=0.0043
WORKER_USD_PER_HOUR=0.05
