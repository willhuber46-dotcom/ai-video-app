# Supabase project (Settings > API). The anon key is safe to ship in the app; RLS protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Shown in Settings. Leave empty until they exist.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=

# Payments (Stripe on the web). The billing server's public URL.
EXPO_PUBLIC_BILLING_URL=
# "link" shows buy buttons that open Stripe checkout; "hidden" only points to
# the website (for store regions that don't allow linking out to payments).
EXPO_PUBLIC_BILLING_MODE=link
EXPO_PUBLIC_BILLING_WEBSITE=
